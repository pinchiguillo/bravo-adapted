PORT=8000
SECRET_KEY=change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SECURE_SSL_REDIRECT=0
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=0
SECURE_HSTS_PRELOAD=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_PROXY_SSL_HEADER=

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/auth_db
REDIS_URL=redis://redis:6379/0

AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_ENDPOINT=http://localstack:4566
LOCALSTACK_ACKNOWLEDGE_ACCOUNT_REQUIREMENT=1
AWS_S3_ENDPOINT_URL=http://localstack:4566
AWS_SES_ENDPOINT_URL=http://localstack:4566
AWS_STORAGE_BUCKET_NAME=bravo-media
AWS_LEGAL_DOCUMENTS_BUCKET_NAME=bravo-media-legal
AWS_S3_PUBLIC_URL=
AWS_S3_PRESIGNED_URL_ENDPOINT=
MEDIA_PUBLIC_BASE_URL=/s3
LEGAL_DOCUMENTS_UPLOAD_PREFIX=legal-documents
USE_S3_STORAGE=1
USE_SES_EMAIL=1

DEFAULT_FROM_EMAIL=no-reply@bravo.local
LEGAL_DOCUMENT_MAX_BYTES=10485760
LEGAL_DOCUMENT_ALLOWED_CONTENT_TYPES=application/pdf
EMAIL_BACKEND=
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
AUTH_BYPASS_EMAIL_VERIFICATION=1
BYPASS_ORGANIZATION_VALIDATION=0
BYPASS_ADMIN_LOGIN=0
AUTH_ENFORCE_PASSWORD_RESTRICTIONS=1
HIDE_API_DOCS=0
RGPD_MODULE_ENABLED=0

POSTGRES_DB=auth_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

JOB_CHAT_ATTACHMENT_MAX_BYTES=5242880
JOB_CHAT_ATTACHMENT_URL_TTL_SECONDS=300
JOB_CHAT_ATTACHMENT_ALLOWED_CONTENT_TYPES=application/pdf,image/jpeg,image/png,text/plain

CLOUDFLARED_TUNNEL_TOKEN=

IMAGE_TAG=latest
WATCHTOWER_POLL_INTERVAL=3600
